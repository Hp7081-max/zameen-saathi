CORS_ORIGINS=http://localhost:5173
OCR_ENGINE=demo           # असली OCR के लिए: tesseract (Docker में default)
AUTH_REQUIRED=1           # लोकल टेस्टिंग में 0 कर सकते हो
OTP_MODE=demo             # demo: OTP स्क्रीन पर दिखता है (असली जाँच नहीं)। असली: sms
AUTH_SALT=isko-badal-do   # OTP_MODE=sms में बदलना ज़रूरी, वरना सर्वर शुरू ही नहीं होगा

# असली SMS (OTP_MODE=sms)। भारत में DLT-मंज़ूर टेम्पलेट चाहिए
SMS_PROVIDER=             # msg91 या twilio
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

REDIS_URL=                # खाली = memory (एक ही instance)। कई instance पर: redis://host:6379/0
MAX_EXTRACT_PER_10MIN=20  # हर session पर फ़ोटो/PDF पढ़ने की सीमा

# IP के हिसाब से सीमा। CSC/साइबर कैफ़े में कई लोग एक IP से आते हैं, इसलिए सीमाएँ खुली रखी हैं
TRUSTED_PROXY_HOPS=1      # सर्वर के आगे कितने proxy हैं (nginx=1, nginx+Cloudflare=2, सीधा=0)। गलत रखा तो IP नकली बन सकता है
MAX_OTP_PER_IP_10MIN=30
MAX_VERIFY_PER_IP_10MIN=60
MAX_EXTRACT_PER_IP_10MIN=100
MAX_PDF_PAGES=8

# ---- v6: होम पन्ने की गिनती और संपर्क फ़ॉर्म ----
DATA_DIR=                 # खाली = backend/data/। यहीं stats.json (अनाम गिनती) और contact.jsonl (संदेश) बनते हैं। Render पर स्थायी Disk का रास्ता दो
MAX_CONTACT_PER_IP_10MIN=5   # संपर्क संदेश: IP पर सीमा (spam से बचाव)
MAX_STATS_PER_IP_10MIN=600   # होम पन्ना हर 30 सेकंड गिनती पूछता है
MAX_CONTACT_FILE_MB=5        # contact.jsonl इससे बड़ी हो तो नए संदेश नहीं लेंगे (डिस्क भरने से बचाव)
ADMIN_TOKEN=              # खाली = संदेश पढ़ने वाला रास्ता बंद। भरो तो: curl -H "x-admin-token: ..." /api/admin/contact
