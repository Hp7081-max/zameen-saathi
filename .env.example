CORS_ORIGINS=http://localhost:5173
OCR_ENGINE=demo           # असली OCR के लिए: tesseract (Docker में default)
AUTH_REQUIRED=1           # लोकल टेस्टिंग में 0 कर सकते हो
OTP_MODE=demo             # demo: OTP स्क्रीन पर दिखता है (असली जाँच नहीं)। असली: sms
AUTH_SALT=isko-badal-do   # OTP_MODE=sms में बदलना ज़रूरी, वरना सर्वर शुरू ही नहीं होगा

# असली SMS (OTP_MODE=sms)। भारत में DLT-मंज़ूर टेम्पलेट चाहिए
SMS_PROVIDER=             # msg91 या twilio
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

REDIS_URL=                # खाली = memory (एक ही instance)। कई instance पर: redis://host:6379/0
MAX_EXTRACT_PER_10MIN=20  # हर session पर फ़ोटो/PDF पढ़ने की सीमा
MAX_PDF_PAGES=8
